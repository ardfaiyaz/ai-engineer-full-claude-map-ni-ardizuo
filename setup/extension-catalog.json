    {"id": "agentation", "kind": "guided", "groups": ["priority", "frontend"], "scope": "project", "commands": ["npm install -D agentation", "claude mcp add agentation -- npx -y agentation-mcp server"], "docs": "https://github.com/benjitaylor/agentation", "caution": "PolyForm Shield 1.0.0 license (not OSI open source). React/Next.js projects only."},
