  "schemaVersion": 1,
  "purpose": "Opt-in extension catalog: researched candidates beyond the 12-plugin / 9-MCP reference baseline. Names, sources and install commands only; no third-party content is bundled.",
  "lastVerified": "2026-10-11",
  "verificationMethod": "GitHub API: repository exists, license, default-branch HEAD commit, .claude-plugin marketplace/plugin manifests and SKILL.md/command paths. Not a runtime, authentication or Windows execution test.",
  "policy": {
    "defaultInstall": false,
    "includedInAllSwitch": false,
    "requiresExternalFlag": true,
    "states": ["discovered", "documented", "installed", "enabled", "authenticated", "tested"],
    "rules": [
      "Install selected extensions only; never stack alternatives that enforce the same operation.",
      "Plugin installs are skipped when the exact ID is already enabled in settings.json.",
      "MCP registrations are skipped when the server name already exists in ~/.claude.json.",
      "Project-scoped and reference entries are printed as guidance and never executed by the installer.",
      "No credentials are read, embedded or printed."
    ]
  },
