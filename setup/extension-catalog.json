    {"id": "firecrawl", "kind": "plugin", "pluginId": "firecrawl@claude-plugins-official", "groups": ["priority", "research"], "scope": "user", "credentials": "Firecrawl API key (provider flow; never pasted into this repository)", "caution": "Use for extraction/crawling; Tavily remains the web-search default."},
    {"id": "exa", "kind": "plugin", "pluginId": "exa@claude-plugins-official", "groups": ["research"], "scope": "user", "credentials": "Exa API key or provider OAuth", "caution": "Overlaps Tavily web search."},
