    {"id": "beads", "kind": "guided", "groups": ["priority"], "scope": "project", "commands": ["npm install -g @beads/bd", "claude plugin marketplace add gastownhall/beads", "claude plugin install beads@beads-marketplace"], "docs": "https://github.com/gastownhall/beads", "caution": "Repository moved from steveyegge/beads. Overlaps issue tracking and the vault."},
