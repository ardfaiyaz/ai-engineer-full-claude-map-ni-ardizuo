    {"id": "playwright-mcp", "kind": "mcp", "name": "playwright-mcp", "groups": [], "alternative": true, "exclusiveGroup": "browser-automation", "scope": "user", "prerequisites": ["npx"], "credentials": null, "argv": ["claude", "mcp", "add", "--scope", "user", "playwright-mcp", "--", "npx", "-y", "@playwright/mcp@latest"], "caution": "Alternative to the existing playwright@claude-plugins-official plugin; do not run both against one browser."},
    {"id": "compound-engineering", "kind": "plugin", "pluginId": "compound-engineering@compound-engineering-plugin", "groups": [], "alternative": true, "exclusiveGroup": "orchestration", "scope": "user", "credentials": null, "caution": "Alternative orchestration to Superpowers + SuperClaude + the five-stage workflow."},
    {"id": "claude-mem", "kind": "plugin", "pluginId": "claude-mem@thedotmack", "groups": [], "alternative": true, "exclusiveGroup": "memory", "scope": "user", "credentials": null, "caution": "Stores session memory locally; review privacy and overlap with Obsidian vault-learning."},
    {"id": "tdd-guard", "kind": "plugin", "pluginId": "tdd-guard@tdd-guard", "groups": [], "alternative": true, "exclusiveGroup": "tdd-enforcement", "scope": "user", "credentials": null, "caution": "Predecessor of Probity; choose one TDD enforcement policy."},
    {"id": "autoharness", "kind": "plugin", "pluginId": "autoharness@autoharness", "groups": [], "alternative": true, "scope": "user", "credentials": null, "caution": "Experimental; Windows support not verified."},
    {"id": "i-have-adhd", "kind": "plugin", "pluginId": "i-have-adhd@i-have-adhd", "groups": [], "alternative": true, "exclusiveGroup": "response-style", "scope": "user", "credentials": null, "caution": "Changes response style globally; disable with claude plugin disable i-have-adhd."},
