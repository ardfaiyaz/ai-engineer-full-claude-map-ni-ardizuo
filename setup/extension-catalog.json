    {"id": "karpathy-skills", "kind": "guided", "groups": ["engineering"], "scope": "user", "commands": ["git clone https://github.com/benfngu/karpathy-claude-skills.git", "Copy skills/karpathy-coding-loop and skills/karpathy-verification into <ClaudeConfig>/skills/ after review"], "docs": "https://github.com/benfngu/karpathy-claude-skills", "caution": "No marketplace; upstream install.sh is Bash-only. Low adoption; review before use."},
    {"id": "snyk-agent-scan", "kind": "guided", "groups": ["security"], "scope": "on-demand", "commands": ["uvx snyk-agent-scan@latest"], "docs": "https://github.com/snyk/agent-scan", "caution": "May send tool descriptions to Snyk for analysis; review privacy first."},
    {"id": "ccusage", "kind": "guided", "groups": [], "scope": "on-demand", "commands": ["npx ccusage@latest"], "docs": "https://github.com/ccusage/ccusage", "caution": "Repository moved from ryoppippi/ccusage. Overlaps Claude Map usage views."},
    {"id": "spec-kit", "kind": "guided", "groups": [], "scope": "project", "commands": ["uv tool install specify-cli", "specify init <project> --integration claude"], "docs": "https://github.com/github/spec-kit", "caution": "Alternative to the Contract stage."},
    {"id": "stagehand", "kind": "guided", "groups": [], "scope": "project", "commands": ["npm install @browserbasehq/stagehand"], "docs": "https://github.com/browserbase/stagehand", "caution": "SDK for browser automation; Browserbase account needed for hosted browsers."},
    {"id": "toolhive", "kind": "guided", "groups": [], "scope": "user", "commands": ["Download from https://stacklok.com/download/"], "docs": "https://github.com/stacklok/toolhive", "caution": "Only useful when managing many MCP servers in containers."},
    {"id": "gstack", "kind": "guided", "groups": [], "alternative": true, "exclusiveGroup": "orchestration", "scope": "user", "commands": ["git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git <ClaudeConfig>/skills/gstack", "Run its setup script from a Bash shell after review"], "docs": "https://github.com/garrytan/gstack", "caution": "Its setup asks to edit CLAUDE.md and to avoid other browser tools; conflicts with the Ardizuo workflow."},
