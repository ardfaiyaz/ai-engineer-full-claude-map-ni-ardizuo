{
  "schemaVersion": 1,
  "purpose": "Extended stack installed by the one-command full installation (-All): researched publisher plugins, MCP registrations, global CLI tools and pinned skill files beyond the 12-plugin / 9-MCP reference baseline. Names, sources and install commands only; no third-party content is bundled.",
  "lastVerified": "2026-10-11",
  "verificationMethod": "GitHub API: repository exists, license, default-branch HEAD commit, .claude-plugin marketplace/plugin manifests and SKILL.md/command paths. Not a runtime, authentication or Windows execution test.",
  "policy": {
    "defaultInstall": true,
    "includedInAllSwitch": true,
    "requiresExternalFlag": true,
    "states": [
      "discovered",
      "documented",
      "installed",
      "enabled",
      "authenticated",
      "tested"
    ],
    "rules": [
      "-All installs every package with an executable kind; --extensions <ids|groups> installs a subset.",
      "Plugin installs are skipped when the exact ID is already enabled in settings.json.",
      "MCP registrations are skipped when the server name already exists in ~/.claude.json.",
      "Global CLI tools are skipped when their command is already on PATH.",
      "Pinned skill files are downloaded at a fixed commit, Git-blob verified and created only when absent.",
      "Overlapping packages are installed together and reported as a warning; disable one if they conflict.",
      "Per-project steps, credential-gated registrations and references are printed, never executed.",
      "wshobson social-media plugins (social-publishing, hermes-tweet) are excluded under the no-social-automation rule.",
      "No credentials are read, embedded or printed."
    ]
  },
